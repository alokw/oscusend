# OSCSend Configuration

# Hotkey to trigger OSC messages
# Format: modifier+key (modifiers: cmd, ctrl, shift, option/alt)
# Examples: cmd+f15, cmd+shift+a, ctrl+option+f1
HOTKEY=cmd+f15

# OSC Destination 1
OSC_DEST1_IP=10.10.20.101
OSC_DEST1_PORT=5000
OSC_DEST1_PATH=/millumin/action/launchNextColumn
OSC_DEST1_VALUE=next

# OSC Destination 2
OSC_DEST2_IP=10.10.20.102
OSC_DEST2_PORT=5000
OSC_DEST2_PATH=/millumin/action/launchNextColumn
OSC_DEST2_VALUE=next